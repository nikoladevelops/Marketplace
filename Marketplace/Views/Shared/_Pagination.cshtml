@using Marketplace.Utility
@model Marketplace.ViewModels.PaginationViewModel
@{
    // Pagination - single reusable bar for the whole app.
    // Uses PaginationHelper so Home, Admin, Profile, Inbox and Thread all look the same.

    int current = Model.PageNumber;
    int total = Model.MaxCountPages;
    string baseUrl = Model.BaseUrl ?? "";
    string paramName = string.IsNullOrWhiteSpace(Model.PageParamName) ? "pageNumber" : Model.PageParamName;
    int window = Model.WindowSize <= 0 ? 5 : Model.WindowSize;

    bool hasPrev = current > 0;
    bool hasNext = total > 0 && current < total - 1;

    // Helper builds a centered window with first/last always visible.
    var pages = PaginationHelper.GetDisplayPages(current, total, window);

    // Helper to build a URL for a zero-based page index.
    string BuildUrl(int zeroBasedIndex)
    {
        string sep = baseUrl.Contains("?") ? "&" : "?";
        return $"{baseUrl}{sep}{paramName}={zeroBasedIndex}";
    }
}

@* Hide completely when there is nothing to page through *@
@if (total > 1)
{
    <div class="text-center pagination-links mt-4">
        @if (hasPrev)
        {
            <a href="@BuildUrl(current - 1)" data-page="@(current - 1)" class="page-nav" title="Previous page" aria-label="Previous page">&#60;</a>
        }
        else
        {
            <span class="page-nav disabled" aria-disabled="true" title="Previous page">&#60;</span>
        }

        @foreach (var p in pages)
        {
            if (p == null)
            {
                <span class="px-1 text-muted">...</span>
            }
            else if (p.Value == current)
            {
                <span class="active" aria-current="page" data-page="@p.Value">@(p.Value + 1)</span>
            }
            else
            {
                <a href="@BuildUrl(p.Value)" data-page="@p.Value">@(p.Value + 1)</a>
            }
        }

        @if (hasNext)
        {
            <a href="@BuildUrl(current + 1)" data-page="@(current + 1)" class="page-nav" title="Next page" aria-label="Next page">&#62;</a>
        }
        else
        {
            <span class="page-nav disabled" aria-disabled="true" title="Next page">&#62;</span>
        }
    </div>
}
