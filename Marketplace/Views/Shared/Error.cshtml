@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

@* Error page - friendly message when something goes wrong *@
<div class="container py-5 text-center">
    <h1 class="display-5 fw-bold text-danger">Oops!</h1>
    <p class="text-muted mb-4">An error occurred while processing your request.</p>

    @if (Model?.ShowRequestId ?? false)
    {
        <p class="text-muted small"><strong>Request ID:</strong> <code>@Model?.RequestId</code></p>
    }

    @if (!string.Equals(System.Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT"), "Development", StringComparison.OrdinalIgnoreCase))
    {
        <p class="text-muted small mb-0">Please try again later, or go back to the <a asp-controller="Home" asp-action="Index">home page</a>.</p>
    }
    else
    {
        <div class="alert alert-secondary text-start rounded-4 mx-auto" style="max-width: 720px;">
            <strong>Development Mode</strong>
            <p class="mb-0 small">Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.</p>
        </div>
    }
</div>
