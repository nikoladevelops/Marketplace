@using Marketplace.Utility
@inject Microsoft.AspNetCore.Identity.SignInManager<Marketplace.Models.ApplicationUser> _signInManager
@inject Microsoft.AspNetCore.Identity.UserManager<Marketplace.Models.ApplicationUser> _userManager
@inject Marketplace.Models.ApplicationDbContext _db

@{
    int unreadCount = 0;
    if (_signInManager.IsSignedIn(User))
    {
        var meId = _userManager.GetUserId(User);
        unreadCount = _db.ChatMessages.Count(m => m.ReceiverId == meId && !m.IsReadByReceiver);
    }
}

<ul class="navbar-nav flex-grow-1">
    <li class="nav-item">
        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
    </li>
    @if (_signInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="" asp-controller="Account" asp-action="MyAdvertisements">My Advertisements</a>
        </li>
        <li class="nav-item" id="navbarMessagesItem">
            <a id="navbarMessagesLink" class="nav-link d-flex align-items-center gap-1 position-relative" asp-area="" asp-controller="Chat" asp-action="Inbox" data-unread="@unreadCount" data-username="@User.Identity?.Name">
                💬 Messages
                <span id="navbarUnreadBadge" class="badge rounded-pill bg-danger @(unreadCount > 0 ? "" : "d-none")">@unreadCount</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-area="" asp-controller="Account" asp-action="MyProfile">My Profile</a>
        </li>

        if (User.IsInRole(Helper.AdminRole))
        {
            <li class="nav-item">
                <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="AdminPanel">Admin Panel</a>
            </li>
        }
    }
</ul>

@if (_signInManager.IsSignedIn(User))
{
    <span class="navbar-username d-none d-sm-inline text-muted fw-medium ms-2 ms-sm-3 me-2 align-self-center text-truncate" style="max-width: 140px;" title="@(User.Identity?.Name ?? "")">@(User.Identity?.Name ?? "")</span>
    <ul class="navbar-nav flex-row align-items-center gap-2">
        <li class="nav-item">
            <form asp-action="LogOut" asp-controller="Account" class="m-0">
                <button type="submit" class="btn btn-outline-secondary btn-sm rounded-3">Log out</button>
            </form>
        </li>
    </ul>

}
else
{
    <ul class="navbar-nav flex-row gap-1">
        <li class="nav-item">
            <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
        </li>
    </ul>
}