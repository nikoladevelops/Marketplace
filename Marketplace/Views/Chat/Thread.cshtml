@model Marketplace.ViewModels.ChatThreadViewModel
@{
    ViewData["Title"] = "Chat with " + Model.PartnerName;
}

@* Chat thread page - conversation with a seller or buyer for a specific ad *@
<div class="container px-2 px-sm-3" style="max-width: 760px;">
    <div class="page-header flex-wrap gap-2">
        <h3 class="mb-0">💬 Chat</h3>
        <a asp-controller="Chat" asp-action="Inbox" class="btn btn-outline-primary btn-sm rounded-3 ms-auto">📥 Inbox</a>
    </div>

    @* Feedback alerts for chat errors or notices *@
    @if (TempData["ChatError"] is string chatError)
    {
        <div class="alert alert-danger rounded-4 border-0 shadow-sm d-flex align-items-start gap-2 alert-dismissible fade show" role="alert">
            <span class="flex-shrink-0" style="font-size:1.1rem;">⚠️</span>
            <div class="flex-grow-1">@chatError</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ChatNotice"] is string chatNotice)
    {
        <div class="alert alert-success rounded-4 border-0 shadow-sm d-flex align-items-start gap-2 alert-dismissible fade show" role="alert">
            <span class="flex-shrink-0" style="font-size:1.1rem;">✅</span>
            <div class="flex-grow-1">@chatNotice</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Ad context card - shows which listing this chat is about *@
    <div class="card shadow-sm border-0 rounded-4 p-2 p-sm-3 mb-3">
        <div class="d-flex align-items-center gap-2 gap-sm-3">
            @if (!string.IsNullOrEmpty(Model.AdvertisementImagePath))
            {
                <img src="@Model.AdvertisementImagePath" class="rounded-3 object-fit-cover flex-shrink-0" style="width: 64px; height: 64px;" alt="Advertisement image">
            }

            <div class="flex-grow-1 min-width-0 overflow-hidden">
                <a asp-controller="Advertisement" asp-action="Show" asp-route-id="@Model.AdvertisementId"
                   class="fw-semibold text-decoration-none text-truncate d-block">@Model.AdvertisementTitle</a>
                <span class="ad-price fw-bold small">@Model.AdvertisementPrice</span>
            </div>

            <span class="badge bg-light text-muted border d-none d-sm-inline">Ad #@Model.AdvertisementId</span>
        </div>
    </div>

    @* Partner header with online status and block controls *@
    <div class="card shadow-sm border-0 rounded-4 p-2 p-sm-3 mb-3">
        <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
            <div class="d-flex align-items-center min-width-0 gap-2">
                <span class="fw-semibold text-truncate">@Model.PartnerName</span>

                @if (Model.IsPartnerAdmin)
                {
                    <span class="badge bg-danger flex-shrink-0">Admin</span>
                }

                <span id="connStatus" class="badge flex-shrink-0 chat-status chat-status-connecting" title="Live connection status">connecting…</span>
            </div>

            <div class="d-flex gap-2">
                @if (!Model.AlreadyReportedByMe && !Model.IsPartnerAdmin)
                {
                    <button type="button" class="btn btn-outline-warning btn-sm rounded-3" data-bs-toggle="modal" data-bs-target="#reportModal">🚩 Report</button>
                }
                else if (Model.IsPartnerAdmin)
                {
                    <span class="badge bg-light text-muted border align-self-center">Admin - cannot be reported</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark align-self-center">Reported</span>
                }

                @if (Model.IsBlockedByMe)
                {
                    <form method="post" asp-action="Unblock" asp-route-with="@Model.PartnerName" asp-route-adId="@Model.AdvertisementId" class="d-flex">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-success btn-sm rounded-3">✅ Unblock</button>
                    </form>
                }
                else if (!Model.IsPartnerAdmin)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-3" data-bs-toggle="modal" data-bs-target="#blockConfirmModal">🚫 Block</button>
                }
            </div>
        </div>
    </div>

    @* State banners explain why messaging may be blocked *@
    @if (Model.HasBlockedMe)
    {
        <div class="alert alert-warning rounded-4 border-0 d-flex gap-2 py-2"><span>🔒</span><span>You cannot send messages here - this user has blocked you.</span></div>
    }
    else if (Model.IsBlockedByMe)
    {
        <div class="alert alert-warning rounded-4 border-0 d-flex gap-2 py-2"><span>🚧</span><span>You blocked this user. Unblock to resume the conversation.</span></div>
    }

    @* Messages area with pagination and list - reuses the same bar as Home/Admin/Profile/Inbox *@
    <div class="card shadow-sm border-0 rounded-4 p-0 mb-3 overflow-hidden">
        @if (Model.TotalPages > 1)
        {
            <div class="border-bottom p-2 p-sm-3 d-flex flex-wrap align-items-center justify-content-between gap-2 bg-light bg-opacity-50">
                <small class="text-muted">Page @Model.CurrentPage of @Model.TotalPages • @Model.TotalCount messages</small>

                <partial name="_Pagination" model='new Marketplace.ViewModels.PaginationViewModel { PageNumber = Model.CurrentPage - 1, MaxCountPages = Model.TotalPages, BaseUrl = Url.Action("Thread", new { with = Model.PartnerName, adId = Model.AdvertisementId }) ?? $"/Chat/Thread?with={Model.PartnerName}&adId={Model.AdvertisementId}", PageParamName = "page" }' />
            </div>
        }

        @if (Model.HasNext)
        {
            <div class="text-center p-2 border-bottom bg-light bg-opacity-25">
                <a asp-action="Thread" asp-route-with="@Model.PartnerName" asp-route-adId="@Model.AdvertisementId" asp-route-page="@(Model.CurrentPage+1)" class="btn btn-sm btn-outline-secondary rounded-3">⬆️ Load older messages</a>
            </div>
        }

        <div class="p-3 p-sm-4" id="chatScroll" style="min-height: 320px;">
            <div id="messageList">
                @if (Model.Messages.Count == 0)
                {
                    <p id="emptyState" class="text-muted text-center my-4 mb-0">No messages yet - say hello 👋</p>
                }
                else
                {
                    foreach (var msg in Model.Messages)
                    {
                        <div class="d-flex @(msg.IsMine ? "justify-content-end" : "justify-content-start") mb-2" data-msg-id="@msg.Id">
                            <div class="chat-bubble @(msg.IsMine ? "chat-mine" : "chat-theirs")">
                                @msg.Body
                                <div class="chat-time">@msg.SentAt.ToLocalTime().ToString("dd MMM HH:mm")@(msg.IsMine ? (msg.IsReadByReceiver ? " ✓✓" : " ✓") : "")</div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @if (Model.TotalCount > Model.PageSize)
        {
            <div class="border-top p-2 text-center small text-muted d-none d-sm-block">Showing @Model.Messages.Count of @Model.TotalCount messages • Scroll to see more • Use pagination above for older history</div>
        }
    </div>

    @* Send message form - disabled if chat is blocked *@
    @if (Model.CanSend)
    {
        <form id="chatForm" class="d-flex gap-2 sticky-bottom chat-send-form pt-2 pb-1">
            <input type="text" name="message" id="messageInput" class="form-control rounded-3" maxlength="1000"
                   placeholder="Write a message…" autocomplete="off" required />
            <button type="submit" id="sendButton" class="btn btn-primary px-3 px-sm-4 flex-shrink-0 rounded-3">Send ➤</button>
            @if (Model.HasValidPhone)
            {
                <button type="button" id="sendPhoneBtn" class="btn btn-outline-success flex-shrink-0 rounded-3" title="Share your phone number">📞 Phone</button>
            }
            else
            {
                <a href="/Users/@Model.MyUserName?edit=true" class="btn btn-outline-secondary flex-shrink-0 rounded-3 disabled" title="Add a phone in your profile first">📞 Phone</a>
            }
        </form>

        <form id="sendPhoneForm" method="post" asp-action="SendPhone" asp-route-with="@Model.PartnerName" asp-route-adId="@Model.AdvertisementId" class="d-none">
            @Html.AntiForgeryToken()
        </form>

        <div class="text-muted small mt-1 d-flex justify-content-between"><span class="d-none d-sm-inline">Press Enter to send • 1000 chars max</span><span class="d-sm-none">1000 chars max</span><span id="charCount" class="ms-auto"></span></div>
    }
    else
    {
        <div class="text-center text-muted small py-2">Messaging unavailable</div>
    }
</div>

@* Block confirmation modal - double check before blocking a user *@
<div class="modal fade" id="blockConfirmModal" tabindex="-1" aria-labelledby="blockModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body p-4 text-center">
                <div class="chat-modal-icon mx-auto mb-3">🚫</div>
                <h5 class="fw-bold mb-2" id="blockModalLabel">Block @Model.PartnerName?</h5>
                <p class="text-muted small mb-4">You will not receive further messages from them. You can unblock anytime from this chat.</p>

                <form method="post" asp-action="Block" asp-route-with="@Model.PartnerName" asp-route-adId="@Model.AdvertisementId" class="d-flex gap-2 justify-content-center">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-3 px-4">Block user</button>
                </form>
            </div>
        </div>
    </div>
</div>

@* Report modal - pick reason and describe the issue *@
<div class="modal fade" id="reportModal" tabindex="-1" aria-labelledby="reportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body p-4">
                <h5 class="fw-bold mb-3" id="reportModalLabel">Report chat with @Model.PartnerName</h5>
                <p class="text-muted small">You can report this chat once. An admin will review it.</p>

                <form method="post" asp-action="ReportThread" asp-route-with="@Model.PartnerName" asp-route-adId="@Model.AdvertisementId">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reason <span class="text-danger">*</span></label>
                        <select name="reason" class="form-select rounded-3" required>
                            <option value="">-- pick a reason --</option>
                            <option value="Spam">Spam</option>
                            <option value="Harassment">Harassment</option>
                            <option value="Scam">Scam</option>
                            <option value="InappropriateContent">Inappropriate content</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description <span class="text-danger">*</span> <small class="text-muted">(20-500 chars)</small></label>
                        <textarea name="description" class="form-control rounded-3" rows="4" maxlength="500" minlength="20" required placeholder="Describe what happened..."></textarea>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-warning rounded-3">Send report</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <script>
        window.chatConfig = {
            partnerName: @Json.Serialize(Model.PartnerName),
            myUserName: @Json.Serialize(Model.MyUserName),
            adId: @Model.AdvertisementId
        };
    </script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
    <script>
        (function(){
            var sc = document.getElementById("chatScroll");
            if (sc) { sc.scrollTop = sc.scrollHeight; }
            var input = document.getElementById("messageInput");
            var counter = document.getElementById("charCount");
            if (input && counter) {
                var update = function(){ counter.textContent = input.value.length + "/1000"; };
                input.addEventListener("input", update); update();
            }
        })();
    </script>
}
