@model Marketplace.ViewModels.ChatInboxViewModel
@{
    ViewData["Title"] = "Inbox";
    var startIdx = (Model.CurrentPage - 1) * Model.PageSize + 1;
    var endIdx = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
}

@* Inbox page - lists all conversations for the current user *@
<div class="container px-2 px-sm-3" style="max-width: 760px;" id="inboxRoot"
     data-my-user-name="@User.Identity?.Name">
    <div class="page-header flex-wrap gap-2">
        <h3 class="mb-0">📥 Inbox</h3>

        @if (Model.TotalCount > 0)
        {
            <span class="badge rounded-pill bg-secondary fw-normal ms-1">@Model.TotalCount @(Model.TotalCount==1?"conversation":"conversations")</span>
        }
    </div>

    @if (Model.TotalCount == 0)
    {
        <div class="card shadow-sm border-0 rounded-4 bg-white p-4 p-sm-5 text-center">
            <div class="display-6 mb-2">🕊️</div>
            <h6 class="fw-semibold mb-1">No conversations yet</h6>
            <p class="text-muted small mb-3">Open any advertisement and click "Message Seller" to start chatting.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-3 px-4">Browse listings</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="inbox-scroll">
                @foreach (var convo in Model.Items)
                {
                    var imagePath = !string.IsNullOrEmpty(convo.AdvertisementImagePath) ? convo.AdvertisementImagePath : "/plusSign.png";

                    <a asp-controller="Chat" asp-action="Thread"
                       asp-route-with="@convo.PartnerName" asp-route-adId="@convo.AdvertisementId"
                       class="text-decoration-none text-body inbox-row d-block"
                       data-partner="@convo.PartnerName">
                        <div class="d-flex align-items-center gap-2 gap-sm-3 p-2 p-sm-3 rounded-3 conversation-row @(convo != Model.Items.Last() ? "border-bottom" : "")">
                            <img src="@imagePath" class="rounded-3 object-fit-cover flex-shrink-0" style="width: 56px; height: 56px;" alt="Advertisement image">

                            <div class="flex-grow-1 min-width-0 overflow-hidden">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <span class="fw-semibold text-truncate">@convo.PartnerName</span>

                                    @if (convo.UnreadCount > 0)
                                    {
                                        <span class="badge rounded-pill bg-danger flex-shrink-0 unread-badge"
                                              data-key="@convo.AdvertisementId|@convo.PartnerName">@convo.UnreadCount</span>
                                    }
                                </div>

                                <small class="text-muted text-truncate d-block" style="max-width: 100%;">@convo.AdvertisementTitle</small>
                                <small class="text-body text-truncate d-block inbox-snippet fw-normal opacity-75"
                                       data-key="@convo.AdvertisementId|@convo.PartnerName">@convo.Snippet</small>
                            </div>

                            <small class="text-muted flex-shrink-0 d-none d-sm-block" style="font-size: 0.78rem; white-space: nowrap;">@convo.LastSentAt.ToLocalTime().ToString("dd MMM HH:mm")</small>
                            <small class="text-muted flex-shrink-0 d-sm-none" style="font-size: 0.72rem;">@convo.LastSentAt.ToLocalTime().ToString("HH:mm")</small>
                        </div>
                    </a>
                }
            </div>

            @* Pagination for inbox when there are many conversations - reuses the same bar as Home/Admin/Profile *@
            @if (Model.TotalPages > 1)
            {
                <div class="border-top p-2 p-sm-3 d-flex flex-column flex-sm-row align-items-center justify-content-between gap-2 bg-light bg-opacity-50">
                    <small class="text-muted">Showing @startIdx-@endIdx of @Model.TotalCount</small>

                    <partial name="_Pagination" model='new Marketplace.ViewModels.PaginationViewModel { PageNumber = Model.CurrentPage - 1, MaxCountPages = Model.TotalPages, BaseUrl = Url.Action("Inbox") ?? "/Chat/Inbox", PageParamName = "page" }' />
                </div>
            }
        </div>

        <p class="text-muted small mt-2 mb-0 d-block d-sm-none text-center">Tap a conversation to open chat • Scroll for more</p>
    }
</div>

@section Scripts {
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/chatInbox.js" asp-append-version="true"></script>
}

<style>
    .conversation-row { transition: background-color 0.15s ease; }
    .conversation-row:hover { background-color: var(--surface-2); }
</style>
