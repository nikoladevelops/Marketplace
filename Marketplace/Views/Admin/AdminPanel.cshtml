@using Marketplace.Utility
@model Marketplace.ViewModels.AdminPanelViewModel
@{
    var userExists = Model != null && !Model.UserNotFound;
    var userDoesNotExist = Model != null && Model.UserNotFound;
    var userUpdated = Model != null && Model.UserAccountUpdated;
}
<div class="container" style="max-width: 720px;">
    <div class="page-header">
        <h3>🛡️ Admin Panel</h3>
    </div>

    @if (userUpdated)
    {
        <div class="alert alert-success rounded-4 border-0">User account was updated.</div>
    }

    <div class="card shadow-sm border-0 rounded-4 bg-white p-4 mb-4">
        <form method="post" asp-action="SearchUser" asp-controller="Admin">
            <label class="form-label fw-semibold">Search User</label>
            <input asp-for=Username name="username" class="form-control rounded-3 mb-2" placeholder="Username"/>
            @if (userDoesNotExist)
            {
                <p class="field-validation-error small">User does NOT exist.</p>
            }
            <button class="btn btn-primary mt-2 px-4">Search</button>
        </form>
    </div>

    @if (userExists && !userUpdated)
    {
        <form method="post">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
                <h5 class="mb-1">Managing <span class="text-primary">@Model.Username</span></h5>
                <p class="text-muted small">You can edit this user's account.</p>
                <div class="mb-3">
                    <a asp-controller="Users" asp-action="@Model.Username" class="btn btn-outline-primary btn-sm">Show Profile</a>
                </div>
                <hr>
                <h6 class="fw-semibold text-secondary mb-2">Premium</h6>
                <div class="d-flex gap-2 mb-3">
                    <button type="submit" asp-controller="Admin" asp-action="GiveUserRole" asp-route-userId="@Model.UserId" asp-route-roleName="@Helper.PremiumRole" class="btn btn-success btn-sm">Give Premium</button>
                    <button type="submit" asp-controller="Admin" asp-action="RemoveUserRole" asp-route-userId="@Model.UserId" asp-route-roleName="@Helper.PremiumRole" class="btn btn-outline-danger btn-sm">Remove Premium</button>
                </div>
                <h6 class="fw-semibold text-secondary mb-2">Admin</h6>
                <div class="d-flex gap-2 mb-3">
                    <button type="submit" asp-controller="Admin" asp-action="GiveUserRole" asp-route-userId="@Model.UserId" asp-route-roleName="@Helper.AdminRole" class="btn btn-success btn-sm">Make Admin</button>
                    <button type="submit" asp-controller="Admin" asp-action="RemoveUserRole" asp-route-userId="@Model.UserId" asp-route-roleName="@Helper.AdminRole" class="btn btn-outline-danger btn-sm">Remove Admin</button>
                </div>
                <hr>
                <div>
                    <button type="submit" asp-controller="Admin" asp-action="DeleteAccount" asp-route-userId="@Model.UserId" class="btn btn-danger btn-sm">Delete Account</button>
                </div>
            </div>
        </form>
    }
</div>
