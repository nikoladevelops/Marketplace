@using Marketplace.Utility
@model Marketplace.ViewModels.AdminPanelViewModel
@{
    var hasSearched = !string.IsNullOrWhiteSpace(Model?.SearchTerm);
    var hasResults = Model != null && Model.SearchResults != null && Model.SearchResults.Count > 0;
    var selectedUserId = Model?.UserId;
    var selectedUsername = Model?.Username;
    var searchTerm = Model?.SearchTerm;
}
<div class="container" style="max-width: 900px;">
    <div class="page-header">
        <h3>🛡️ Admin Panel</h3>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success rounded-4 border-0">@statusMessage</div>
    }

    <div class="card shadow-sm border-0 rounded-4 bg-white p-4 mb-4">
        <form method="get" asp-action="AdminPanel" asp-controller="Admin">
            <label class="form-label fw-semibold">Search User</label>
            <input asp-for="SearchTerm" name="searchTerm" class="form-control rounded-3 mb-2" placeholder="Username or email (partial names are fine)"/>
            <small class="text-muted d-block mb-2">Type part of a username or email, e.g. "sell" finds "seller".</small>
            <button class="btn btn-primary mt-2 px-4">🔍 Search</button>
        </form>
    </div>

    @if (hasSearched)
    {
        @if (hasResults)
        {
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">👥 Results</h5>
                    <span class="badge bg-secondary rounded-pill">@Model.SearchResults.Count found</span>
                </div>

                @foreach (var user in Model.SearchResults)
                {
                    var isSelected = user.UserId == selectedUserId;
                    var initial = string.IsNullOrEmpty(user.UserName) ? "?" : user.UserName.Substring(0, 1).ToUpper();
                    <div class="d-flex align-items-center gap-3 py-2 @(isSelected ? "" : "border-bottom")">
                        <div class="rounded-circle bg-primary bg-gradient text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                             style="width: 42px; height: 42px;">
                            @initial
                        </div>
                        <div class="flex-grow-1 min-width-0">
                            <div class="fw-semibold text-truncate">@user.UserName</div>
                            <div class="text-muted small text-truncate">@user.Email</div>
                        </div>
                        <div class="d-flex gap-1 flex-shrink-0">
                            @if (user.IsAdmin)
                            {
                                <span class="badge rounded-pill bg-danger">Admin</span>
                            }
                            @if (user.IsPremium)
                            {
                                <span class="badge rounded-pill bg-warning text-dark">Premium</span>
                            }
                            @if (user.IsSeller)
                            {
                                <span class="badge rounded-pill bg-info text-dark">Seller</span>
                            }
                        </div>
                        <a asp-controller="Admin" asp-action="AdminPanel"
                           asp-route-searchTerm="@searchTerm"
                           asp-route-selectedUserId="@user.UserId"
                           class="btn btn-sm @(isSelected ? "btn-primary" : "btn-outline-primary") flex-shrink-0">
                            @(isSelected ? "Managing" : "Manage")
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card shadow-sm border-0 rounded-4 bg-white p-5 text-center">
                <div class="display-6 mb-2">🕵️</div>
                <h6 class="fw-semibold mb-1">No users found for "@searchTerm"</h6>
                <p class="text-muted small mb-0">Try a shorter fragment — partial usernames and emails both work.</p>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(selectedUserId))
    {
        <div class="card shadow-sm border-0 rounded-4 bg-white p-4 mt-4">
            <form method="post">
                <input type="hidden" name="searchTerm" value="@searchTerm"/>
                <h5 class="mb-1">Managing <span class="text-primary">@selectedUsername</span></h5>
                <p class="text-muted small">You can edit this user's account.</p>
                <div class="mb-3">
                    <a asp-controller="Users" asp-action="@selectedUsername" class="btn btn-outline-primary btn-sm">Show Profile</a>
                </div>
                <hr>
                <h6 class="fw-semibold text-secondary mb-2">Premium</h6>
                <div class="d-flex gap-2 mb-3">
                    <button type="submit" asp-controller="Admin" asp-action="GiveUserRole" asp-route-userId="@selectedUserId" asp-route-roleName="@Helper.PremiumRole" class="btn btn-success btn-sm">Give Premium</button>
                    <button type="submit" asp-controller="Admin" asp-action="RemoveUserRole" asp-route-userId="@selectedUserId" asp-route-roleName="@Helper.PremiumRole" class="btn btn-outline-danger btn-sm">Remove Premium</button>
                </div>
                <h6 class="fw-semibold text-secondary mb-2">Admin</h6>
                <div class="d-flex gap-2 mb-3">
                    <button type="submit" asp-controller="Admin" asp-action="GiveUserRole" asp-route-userId="@selectedUserId" asp-route-roleName="@Helper.AdminRole" class="btn btn-success btn-sm">Make Admin</button>
                    <button type="submit" asp-controller="Admin" asp-action="RemoveUserRole" asp-route-userId="@selectedUserId" asp-route-roleName="@Helper.AdminRole" class="btn btn-outline-danger btn-sm">Remove Admin</button>
                </div>
                <hr>
                <div>
                    <button type="submit" asp-controller="Admin" asp-action="DeleteAccount" asp-route-userId="@selectedUserId" class="btn btn-danger btn-sm" onclick="return confirm('Permanently delete the account @(selectedUsername)? This cannot be undone.');">Delete Account</button>
                </div>
            </form>
        </div>
    }
</div>
