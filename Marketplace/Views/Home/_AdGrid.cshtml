@using Marketplace.Utility
@model Marketplace.ViewModels.HomeViewModel

@* Show empty state when no ads match the current filters *@
@if (Model.Advertisements == null || !Model.Advertisements.Any())
{
    <div class="text-center py-5">
        <h3 class="mb-2">No advertisements found</h3>
        <p class="text-muted mb-0">Try adjusting your search filters or check back later.</p>
    </div>
}
else
{
    @* Header for the listings grid *@
    <h3 class="mb-4 fw-bold">Advertisements</h3>

    @* Grid of ad cards - each card is clickable and records recent view *@
    <div class="row g-3">
        @foreach (var currentAd in Model.Advertisements)
        {
            var recentPayload = System.Text.Json.JsonSerializer.Serialize(new {
                id = currentAd.Id,
                title = currentAd.Title,
                price = PriceFormatter.ToEur(currentAd.Price),
                priceValue = currentAd.Price,
                imagePath = currentAd.ImagePath,
                userId = currentAd.UserId,
                userName = currentAd.UserName,
                categoryId = currentAd.CategoryId,
                category = currentAd.Category,
                location = currentAd.Location
            });

            <div class="col-6 col-md-4 col-lg-3 d-flex flex-column">
                <a asp-action="Show" asp-controller="Advertisement" asp-route-id="@currentAd.Id" class="text-decoration-none flex-fill d-flex w-100 ad-card-link" data-recent-ad="@recentPayload">
                    <div class="card ad-card border-0 rounded-4 overflow-hidden shadow-sm flex-fill w-100 position-relative d-flex flex-column">
                        <div class="ad-card-img-wrap flex-shrink-0">
                            <img src="@currentAd.ImagePath" loading="lazy" alt="Advertisement Image">
                            <span class="badge bg-success ad-badge position-absolute top-0 end-0 m-2">@currentAd.Category</span>
                        </div>

                        <div class="card-body pb-3 d-flex flex-column flex-grow-1">
                            <h6 class="card-title fw-semibold text-truncate mb-1" title="@currentAd.Title">@currentAd.Title</h6>
                            <p class="ad-price h5 mb-1">@PriceFormatter.ToEur(currentAd.Price)</p>
                            <p class="text-muted small mb-2">📍 @currentAd.Location</p>

                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top small">
                                <span class="text-muted text-truncate" title="@currentAd.UserName">👤 @currentAd.UserName</span>
                                <span class="text-muted flex-shrink-0 ms-2">@DateFormatter.ToShortLocationDate(currentAd.DateCreatedOn, currentAd.Location)</span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>

    @* Pagination for browsing through ad pages *@
    <partial name="_Pagination" model='new Marketplace.ViewModels.PaginationViewModel { PageNumber = Model.PageNumber, MaxCountPages = Model.MaxCountPages, BaseUrl = Url.Action("Index", "Home", new { filter = Model.Filter, category = Model.CategoryId == -1 ? "all" : Model.CategoryId.ToString(), searchTerm = Model.SearchTerm, location = Model.Location, minimumPrice = Model.MinimumPrice, maximumPrice = Model.MaximumPrice }) ?? "/" }' />
}
