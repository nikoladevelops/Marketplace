@using Marketplace.Utility
@model Marketplace.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div>
    <div id="recentlyBrowsedContainer"
         class="recently-browsed mb-3"
         data-current-user-id="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")"
         hidden>
    </div>

    <button class="btn btn-outline-secondary d-md-none w-100 mb-2 d-flex align-items-center justify-content-center gap-2" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse" style="min-height:44px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/><circle cx="7" cy="6" r="2"/><circle cx="17" cy="12" r="2"/><circle cx="10" cy="18" r="2"/></svg>
        Filters
    </button>
    <div id="filterCollapse" class="collapse d-md-block">
        <div class="row g-3 justify-content-center mb-2">
            <div class="col-12 col-md-5">
                <input asp-for="SearchTerm" id="searchBar" class="form-control" placeholder="🔍 Search listings" />
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <select id="categoryDropDown" asp-items="@Model.CategoryDropDown" asp-for="CategoryId" class="form-select text-center">
                    <option value="-1">All</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <select id="filterDropDown" asp-for="Filter" class="form-select text-center">
                    <option>New</option>
                    <option>Old</option>
                    <option>Cheapest</option>
                    <option>Most Expensive</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <input id="locationInput" asp-for="Location" class="form-control text-center" placeholder="📍 Location" />
            </div>
            <div class="col-12 col-md-1 d-grid">
                <a id="searchButton" href="#" class="btn btn-primary fw-semibold" aria-label="Search" style="min-height: 44px; display:flex; align-items:center; justify-content:center;">Go</a>
            </div>
        </div>
        <div class="row g-3 justify-content-center mb-3">
            <div class="col-12 col-sm-6 col-md-2">
                <input id="minimumPriceInput" asp-for="MinimumPrice" class="form-control text-center" placeholder="Min price (EUR)" type="number" step="0.01" min="0" />
            </div>
            <div class="col-12 col-sm-6 col-md-2">
                <input id="maximumPriceInput" asp-for="MaximumPrice" class="form-control text-center" placeholder="Max price (EUR)" type="number" step="0.01" min="0" />
            </div>
        </div>
    </div>

    <div id="adGridContainer" class="mt-2" data-page="@Model.PageNumber" data-max-pages="@Model.MaxCountPages">
        <partial name="_AdGrid" model="Model" />
    </div>
</div>

@section Scripts
{
    <script defer>
        let searchDebounce = null;
        let currentAbort = null;

        function buildSearchParams(pageNumber) {
            const categoryDropDown = document.querySelector("#categoryDropDown");
            const filterDropDown = document.querySelector("#filterDropDown");
            const category = categoryDropDown.value || "all";
            const searchTerm = document.querySelector("#searchBar").value.trim();
            const filter = filterDropDown.options[filterDropDown.selectedIndex].text;
            const location = document.querySelector("#locationInput").value.trim();
            const minimumPrice = document.querySelector("#minimumPriceInput").value.trim();
            const maximumPrice = document.querySelector("#maximumPriceInput").value.trim();

            const params = new URLSearchParams();
            params.set("pageNumber", pageNumber ?? 0);
            params.set("filter", filter);
            params.set("category", category);
            if (searchTerm) params.set("searchTerm", searchTerm);
            if (location) params.set("location", location);
            if (minimumPrice) params.set("minimumPrice", minimumPrice);
            if (maximumPrice) params.set("maximumPrice", maximumPrice);
            return params.toString();
        }

        async function fetchGrid(pageNumber) {
            const container = document.getElementById("adGridContainer");
            const maxPages = parseInt(container?.dataset.maxPages || "1", 10);
            if (maxPages > 0 && (pageNumber < 0 || pageNumber >= maxPages)) return;
            if (currentAbort) currentAbort.abort();
            currentAbort = new AbortController();
            const query = buildSearchParams(pageNumber);
            const url = "/Home/Search?" + query;
            try {
                const res = await fetch(url, { signal: currentAbort.signal, headers: { "X-Requested-With": "XMLHttpRequest" } });
                if (!res.ok) throw new Error(res.statusText);
                const html = await res.text();
                container.innerHTML = html;
                // update data attributes from new pagination if present, else keep
                const temp = document.createElement("div");
                temp.innerHTML = html;
                const newPag = temp.querySelector("[data-page]");
                // we rely on server clamped pageNumber – push state after fetch
                history.pushState(null, "", "/?" + query);
                // Update container maxPages after fetch by re-parsing (server will have clamped)
                // Re-attach maxPages from response: try to find pagination active span
                const active = temp.querySelector(".pagination-links .active");
                if (active) {
                    const cur = parseInt(active.getAttribute("data-page") || active.textContent, 10);
                    if (!isNaN(cur)) container.dataset.page = cur;
                } else {
                    container.dataset.page = pageNumber;
                }
            } catch (e) {
                if (e.name !== "AbortError") console.error(e);
            }
        }

        function attachGridHandlers() {
            const container = document.getElementById("adGridContainer");
            if (!container) return;
            container.addEventListener("click", function (e) {
                const link = e.target.closest("a[data-page]");
                if (!link) return;
                if (link.classList.contains("disabled") || link.getAttribute("aria-disabled")==="true") {
                    e.preventDefault();
                    return;
                }
                e.preventDefault();
                const page = parseInt(link.getAttribute("data-page"), 10);
                const maxPages = parseInt(container.dataset.maxPages || "1", 10);
                if (isNaN(page) || page < 0 || (maxPages>0 && page >= maxPages)) return;
                fetchGrid(page);
            });

            // Record an ad view before navigation. We do NOT preventDefault:
            // the click is allowed to proceed to /Advertisement/Show/{id}.
            // Middle-click / cmd-click / right-click also work because the
            // browser fires `click` for primary-button activations only.
            container.addEventListener("click", function (e) {
                const card = e.target.closest("a[data-recent-ad]");
                if (!card) return;
                if (!window.RecentlyViewed) return;
                var raw = card.getAttribute("data-recent-ad");
                if (!raw) return;
                try {
                    var ad = JSON.parse(raw);
                    window.RecentlyViewed.record(ad);
                } catch (_) { /* malformed payload — skip */ }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            attachGridHandlers();

            // Render the Recently Browsed strip on initial load.
            var recentEl = document.getElementById("recentlyBrowsedContainer");
            if (recentEl && window.RecentlyViewed) {
                window.RecentlyViewed.render(recentEl);
            }

            document.getElementById("searchButton").addEventListener("click", function (e) {
                e.preventDefault();
                clearTimeout(searchDebounce);
                if (currentAbort) currentAbort.abort();
                fetchGrid(0);
            });

            const enterHandler = function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    clearTimeout(searchDebounce);
                    if (currentAbort) currentAbort.abort();
                    fetchGrid(0);
                }
            };
            ["searchBar", "locationInput", "minimumPriceInput", "maximumPriceInput"].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.addEventListener("keyup", enterHandler);
            });

            document.getElementById("searchBar").addEventListener("keyup", function (e) {
                if (e.key === "Enter") return;
                clearTimeout(searchDebounce);
                searchDebounce = setTimeout(() => fetchGrid(0), 400);
            });

            ["categoryDropDown", "filterDropDown", "locationInput", "minimumPriceInput", "maximumPriceInput"].forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                const evt = el.tagName === "SELECT" ? "change" : "input";
                el.addEventListener(evt, function () {
                    clearTimeout(searchDebounce);
                    searchDebounce = setTimeout(() => fetchGrid(0), el.tagName === "SELECT" ? 0 : 400);
                });
            });

            window.addEventListener("popstate", function () {
                const params = new URLSearchParams(location.search);
                const p = parseInt(params.get("pageNumber") || "0", 10);
                const maxPages = parseInt(document.getElementById("adGridContainer")?.dataset.maxPages || "1", 10);
                if (!isNaN(p) && p >=0 && (maxPages===0 || p < maxPages)) fetchGrid(p);
                else fetchGrid(0);
            });
        });

        function backArrow(arrowElement, isBackArrow) { return false; }
        function changePage() { return false; }
        function searchFor() { fetchGrid(0); return false; }
        function getSearchQuery() { return buildSearchParams(0); }
        function isNullOrWhitespace(input) { if (typeof input === 'undefined' || input == null) return true; return input.replace(/\s/g, '').length < 1; }
    </script>
}
