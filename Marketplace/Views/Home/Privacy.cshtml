@{
    ViewData["Title"] = "Privacy Policy";
}

@* Privacy policy page - simple friendly explanation of data visibility *@
<div class="container py-4" style="max-width: 720px;">
    <div class="page-header">
        <h3>🔒 Privacy Policy</h3>
    </div>

    <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
        <p class="mb-0">By registering you make your email public information. Anybody visiting your profile or advertisement can see it. In addition, you can also add a phone number to be displayed.</p>
    </div>
</div>
