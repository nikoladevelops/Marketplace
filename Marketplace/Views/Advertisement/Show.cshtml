@using Marketplace.Utility
@model Marketplace.ViewModels.ShowAdvertisementViewModel
@{
    var profilePictureSrc = !string.IsNullOrEmpty(Model.ProfilePicturePath) ? Model.ProfilePicturePath : "/noProfilePicture.png";
    var mainImageSrc = !string.IsNullOrEmpty(Model.ImagePath) ? Model.ImagePath : "/plusSign.png";
    var additionalPaths = Model.AdditionalImagePaths?.ToList() ?? new List<string>();
}

<div class="container">
    <div class="page-header justify-content-center border-0 pb-0 mb-3">
        <h3>Listing Details</h3>
    </div>
</div>

<div class="container">
    <div class="row g-4">
        <!-- Gallery -->
        <div class="col-lg-6">
            <div class="card border-0 rounded-4 shadow-sm overflow-hidden position-relative">
                <div class="show-gallery-main d-flex align-items-center justify-content-center bg-light rounded-3 overflow-hidden">
                    <img id="image1" src="@mainImageSrc" data-lightbox="show-gallery"
                         class="w-100 h-100 object-fit-cover cursor-pointer" alt="Main advertisement image">
                </div>
            </div>
            @if (additionalPaths.Count > 0)
            {
                <div class="row g-2 mt-2">
                    @foreach (var path in additionalPaths)
                    {
                        <div class="col-4 col-md-3">
                            <div class="border rounded-3 overflow-hidden bg-light" style="height: clamp(72px, 11vw, 104px);">
                                <img src="@path" data-lightbox="show-gallery" loading="lazy"
                                     class="w-100 h-100 object-fit-cover cursor-pointer" alt="Additional image">
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Details -->
        <div class="col-lg-6">
            <div class="card border-0 rounded-4 shadow-sm p-4 h-100 d-flex flex-column">
                <h3 class="fw-bold mb-1">@Model.Title</h3>
                <p class="ad-price display-6 mb-0">@Model.Price</p>
                <p class="text-muted small mb-3">📍 @Model.Location · 🏷️ @Model.CategoryName</p>

                @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                {
                    <div class="mb-3">
                        <h6 class="fw-semibold text-secondary mb-2">📍 Meeting point</h6>
                        <div id="locationMapShow" class="location-map-show rounded-3 border"></div>
                    </div>
                    <input type="hidden" id="showLat" value="@Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"/>
                    <input type="hidden" id="showLng" value="@Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"/>
                }
                <hr>
                <h6 class="fw-semibold text-secondary">Description</h6>
                <p class="text-body" style="white-space: pre-line;">@Model.Description</p>
                <p class="text-muted small"><strong>Listed:</strong> @DateFormatter.ToLongLocationDate(Model.DateCreatedOn, Model.Location)</p>

                <!-- Seller -->
                <div class="card bg-light border-0 rounded-3 mt-auto p-3 position-relative">
                    <div class="d-flex align-items-center gap-3">
                        <img src="@profilePictureSrc" class="rounded-circle object-fit-cover" style="width: 64px; height: 64px;" alt="Seller profile picture">
                        <div class="flex-grow-1">
                            <p class="text-muted small mb-0">Seller</p>
                            <a class="fw-semibold text-decoration-none stretched-link" href="/Users/@Model.UserName">@Model.UserName</a>
                        </div>
                    </div>
                </div>
                @if (User.Identity.IsAuthenticated && User.Identity.Name != Model.UserName)
                {
                    <a class="btn btn-success fw-semibold py-2 mt-3 w-100" asp-controller="Chat" asp-action="Thread"
                       asp-route-with="@Model.UserName" asp-route-adId="@Model.Id">💬 Message Seller</a>
                    <button class="btn btn-outline-secondary py-2 mt-2 w-100" onclick="showModal('contactInfoModal')">Contact info (email/phone)</button>
                }
                else
                {
                    <button class="btn btn-success fw-semibold py-2 mt-3" onclick="showModal('contactInfoModal')">Contact Seller</button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Contact Modal -->
<div class="modal fade" id="contactInfoModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title">Seller Contact Information</h5>
                <button onclick="closeModal('contactInfoModal')" type="button" class="btn-close" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Email: <span class="badge bg-success p-2">@Model.Email</span></p>
                @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                {
                    <p class="mb-0">Phone Number: <span class="badge bg-success p-2">@Model.PhoneNumber</span></p>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
}

@section Scripts {
    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
    {
        <script src="~/lib/leaflet/leaflet.js"></script>
        <script src="~/js/locationPicker.js"></script>
        <script>
            (function () {
                var lat = parseFloat(document.getElementById("showLat").value);
                var lng = parseFloat(document.getElementById("showLng").value);
                LocationPicker.init({
                    mapId: "locationMapShow",
                    inputSelector: null,
                    locateBtnId: null,
                    statusElId: null,
                    initial: { lat: lat, lng: lng },
                    interactive: false
                });
            })();
        </script>
    }
    <script src="~/js/imageManipulation.js"></script>
}
