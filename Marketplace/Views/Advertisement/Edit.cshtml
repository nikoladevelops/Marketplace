@model Marketplace.ViewModels.EditAdvertisementViewModel

@* Edit ad page - allows owner to update images and details *@
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">

                <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                    <h3 class="fw-bold text-primary mb-0">✏️ Edit Advertisement</h3>
                </div>

                <form method="post" asp-action="Edit" asp-controller="Advertisement" enctype='multipart/form-data'>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <span class="text-danger d-block mb-2" asp-validation-for="Image"></span>

                    @* Image gallery - main plus three extra images.
                       We keep both the old persisted path and the new Base64 preview so a validation error does not wipe your picks. *@
                    <label class="form-label fw-semibold text-secondary mb-2">Product Images <span class="text-muted small">(Main required, extras optional)</span></label>

                    <div class="row g-3 mb-4">
                        @* Main image slot *@
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border-2 border-primary rounded-3 overflow-hidden shadow-sm">
                                <div class="card-body p-0 position-relative bg-light text-center d-flex align-items-center justify-content-center img-slot">
                                    @{
                                        var mainPreview = !string.IsNullOrEmpty(Model.MainImageBase64) ? Model.MainImageBase64 : (!string.IsNullOrEmpty(Model.ExistingImagePath) ? Model.ExistingImagePath : "/plusSign.png");
                                        var mainDataPath = Model.MainImageBase64 ?? Model.ExistingImagePath ?? "";
                                    }
                                    <img id="image1" src="@mainPreview"
                                         data-existing-path="@mainDataPath"
                                         data-original-path="@Model.ExistingImagePath"
                                         class="w-100 h-100 object-fit-cover cursor-pointer"
                                         onclick="handleImageClick(1, 'imageInput1')" title="Click to view or change">
                                    <input asp-for="Image" id="imageInput1" class="d-none" type="file" onchange="handleFileSelected(this, 1)" accept="image/jpeg, image/png"/>
                                </div>
                                <div class="card-footer bg-white border-0 p-2 text-center">
                                    <button id="button1" type="button" onclick="deleteImage(1, 'existingMainPath')" class="btn btn-sm btn-outline-danger w-100" disabled>Remove</button>
                                </div>
                            </div>
                            <small class="text-muted d-block text-center mt-1">Main Image <span class="text-danger">*</span></small>
                        </div>

                        @* Additional image 1 *@
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border rounded-3 overflow-hidden shadow-sm">
                                <div class="card-body p-0 position-relative bg-light text-center d-flex align-items-center justify-content-center img-slot">
                                    @{
                                        var p0 = Model.ExistingAdditionalImagePaths?.ElementAtOrDefault(0) ?? "";
                                        var p0Preview = !string.IsNullOrEmpty(Model.AdditionalImageBase64_1) ? Model.AdditionalImageBase64_1 : (!string.IsNullOrEmpty(p0) ? p0 : "/plusSign.png");
                                        var p0Data = Model.AdditionalImageBase64_1 ?? p0;
                                    }
                                    <img id="image2" src="@p0Preview"
                                         data-existing-path="@p0Data"
                                         data-original-path="@p0"
                                         class="w-100 h-100 object-fit-cover cursor-pointer"
                                         onclick="handleImageClick(2, 'imageInput2')" title="Click to view or change">
                                    <input asp-for="AdditionalImage1" id="imageInput2" class="d-none" type="file" onchange="handleFileSelected(this, 2)" accept="image/jpeg, image/png"/>
                                </div>
                                <div class="card-footer bg-white border-0 p-2 text-center">
                                    <button id="button2" type="button" onclick="deleteImage(2, 'existingAdditionalPath0')" class="btn btn-sm btn-outline-danger w-100" disabled>Remove</button>
                                </div>
                            </div>
                            <small class="text-muted d-block text-center mt-1">Extra 1 <span class="text-muted">optional</span></small>
                        </div>

                        @* Additional image 2 *@
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border rounded-3 overflow-hidden shadow-sm">
                                <div class="card-body p-0 position-relative bg-light text-center d-flex align-items-center justify-content-center img-slot">
                                    @{
                                        var p1 = Model.ExistingAdditionalImagePaths?.ElementAtOrDefault(1) ?? "";
                                        var p1Preview = !string.IsNullOrEmpty(Model.AdditionalImageBase64_2) ? Model.AdditionalImageBase64_2 : (!string.IsNullOrEmpty(p1) ? p1 : "/plusSign.png");
                                        var p1Data = Model.AdditionalImageBase64_2 ?? p1;
                                    }
                                    <img id="image3" src="@p1Preview"
                                         data-existing-path="@p1Data"
                                         data-original-path="@p1"
                                         class="w-100 h-100 object-fit-cover cursor-pointer"
                                         onclick="handleImageClick(3, 'imageInput3')" title="Click to view or change">
                                    <input asp-for="AdditionalImage2" id="imageInput3" class="d-none" type="file" onchange="handleFileSelected(this, 3)" accept="image/jpeg, image/png"/>
                                </div>
                                <div class="card-footer bg-white border-0 p-2 text-center">
                                    <button id="button3" type="button" onclick="deleteImage(3, 'existingAdditionalPath1')" class="btn btn-sm btn-outline-danger w-100" disabled>Remove</button>
                                </div>
                            </div>
                            <small class="text-muted d-block text-center mt-1">Extra 2 <span class="text-muted">optional</span></small>
                        </div>

                        @* Additional image 3 *@
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border rounded-3 overflow-hidden shadow-sm">
                                <div class="card-body p-0 position-relative bg-light text-center d-flex align-items-center justify-content-center img-slot">
                                    @{
                                        var p2 = Model.ExistingAdditionalImagePaths?.ElementAtOrDefault(2) ?? "";
                                        var p2Preview = !string.IsNullOrEmpty(Model.AdditionalImageBase64_3) ? Model.AdditionalImageBase64_3 : (!string.IsNullOrEmpty(p2) ? p2 : "/plusSign.png");
                                        var p2Data = Model.AdditionalImageBase64_3 ?? p2;
                                    }
                                    <img id="image4" src="@p2Preview"
                                         data-existing-path="@p2Data"
                                         data-original-path="@p2"
                                         class="w-100 h-100 object-fit-cover cursor-pointer"
                                         onclick="handleImageClick(4, 'imageInput4')" title="Click to view or change">
                                    <input asp-for="AdditionalImage3" id="imageInput4" class="d-none" type="file" onchange="handleFileSelected(this, 4)" accept="image/jpeg, image/png"/>
                                </div>
                                <div class="card-footer bg-white border-0 p-2 text-center">
                                    <button id="button4" type="button" onclick="deleteImage(4, 'existingAdditionalPath2')" class="btn btn-sm btn-outline-danger w-100" disabled>Remove</button>
                                </div>
                            </div>
                            <small class="text-muted d-block text-center mt-1">Extra 3 <span class="text-muted">optional</span></small>
                        </div>
                    </div>

                    @* Hidden Base64 carriers - they survive a post-back when ModelState is invalid *@
                    <input type="hidden" asp-for="MainImageBase64" id="editMainBase64" />
                    <input type="hidden" asp-for="MainImageFileName" id="editMainFileName" />
                    <input type="hidden" asp-for="AdditionalImageBase64_1" id="editAdditionalBase64_1" />
                    <input type="hidden" asp-for="AdditionalImageFileName1" id="editAdditionalFileName1" />
                    <input type="hidden" asp-for="AdditionalImageBase64_2" id="editAdditionalBase64_2" />
                    <input type="hidden" asp-for="AdditionalImageFileName2" id="editAdditionalFileName2" />
                    <input type="hidden" asp-for="AdditionalImageBase64_3" id="editAdditionalBase64_3" />
                    <input type="hidden" asp-for="AdditionalImageFileName3" id="editAdditionalFileName3" />

                    @* AI helper - scan images to refresh title and description *@
                    <div class="p-3 mb-4 bg-light rounded-3 border border-primary-subtle text-center">
                        <button type="button" id="aiGenerateBtn" onclick="triggerSmartListingAI()" class="btn btn-primary fw-semibold px-4 shadow-sm" disabled>
                            ✨ Re-Scan and Refresh Details with AI
                        </button>
                        <small class="text-muted d-block mt-1">AI will analyze your images to update your title and description.</small>
                    </div>

                    @* Title - required, 3 to 35 chars *@
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Title <span class="text-danger">*</span> <small class="text-muted fw-normal">(3-35 characters)</small></label>
                        <input class="form-control form-control-lg rounded-3" asp-for="Title" placeholder="e.g. iPhone 15 Pro Max 256GB" maxlength="35" />
                        <div class="d-flex justify-content-between">
                            <span asp-validation-for="Title" class="text-danger small"></span>
                            <small class="text-muted"><span id="titleCounter">0</span>/35</small>
                        </div>
                    </div>

                    @* Description - required, 20 to 250 chars *@
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description <span class="text-danger">*</span> <small class="text-muted fw-normal">(20-250 characters)</small></label>
                        <textarea class="form-control rounded-3" asp-for="Description" rows="6" placeholder="Provide a detailed description of your item..." maxlength="250"></textarea>
                        <div class="d-flex justify-content-between">
                            <span asp-validation-for="Description" class="text-danger small"></span>
                            <small class="text-muted"><span id="descriptionCounter">0</span>/250</small>
                        </div>
                    </div>

                    @* Price and location row *@
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="form-label fw-semibold">Price (EUR) <span class="text-danger">*</span> <small class="text-muted fw-normal">(1-1,000,000)</small></label>
                            <div class="input-group">
                                <span class="input-group-text">€</span>
                                <input class="form-control rounded-end-3" asp-for="Price" placeholder="0.00" type="number" step="0.01" min="1" max="1000000" />
                            </div>
                            <small class="text-muted">Price in EUR, required</small>
                            <span asp-validation-for="Price" class="text-danger small d-block"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Location" class="form-label fw-semibold">Location <span class="text-danger">*</span> <small class="text-muted fw-normal">(2-100 characters)</small></label>
                            <div class="d-flex gap-2">
                                <input class="form-control rounded-3" asp-for="Location" placeholder="e.g. Sofia, Bulgaria" maxlength="100" />
                                <button type="button" id="detectLocationBtn" class="btn btn-outline-primary rounded-3 flex-shrink-0" title="Detect my location">📍 Detect</button>
                            </div>
                            <span asp-validation-for="Location" class="text-danger small"></span>
                            <small id="locationStatus" class="d-block text-muted small mt-1"></small>
                        </div>
                    </div>

                    @* Interactive map for picking exact meeting point - optional *@
                    <div class="mb-4">
                        <div id="locationMap" class="location-map-inline rounded-3 border"></div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-muted">Click the map or drag the pin to set the exact meeting point. <span class="text-muted">(optional)</span></small>
                            <button type="button" class="btn btn-link btn-sm p-0" data-bs-toggle="modal" data-bs-target="#locationMapModal">⤢ Expand map</button>
                        </div>
                        <input type="hidden" asp-for="Latitude"/>
                        <input type="hidden" asp-for="Longitude"/>
                    </div>

                    @* Category dropdown - required *@
                    <div class="mb-4">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" asp-items="@Model.CategoryDropDown" class="form-select rounded-3">
                            <option value="-1">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    @* Form actions - save or cancel *@
                    <div class="d-flex gap-2 pt-3 border-top">
                        <button type="submit" class="btn btn-success px-4 fw-semibold rounded-3 shadow-sm">Save Changes</button>
                        <a class="btn btn-light px-4 rounded-3 border" href="/Users/@User.Identity?.Name">Cancel</a>
                    </div>

                    @* Hidden fields to track existing image paths for the server *@
                    <input asp-for="ExistingImagePath" type="hidden" id="existingMainPath"/>
                    <input name="ExistingAdditionalImagePaths[0]" type="hidden" id="existingAdditionalPath0" value="@p0"/>
                    <input name="ExistingAdditionalImagePaths[1]" type="hidden" id="existingAdditionalPath1" value="@p1"/>
                    <input name="ExistingAdditionalImagePaths[2]" type="hidden" id="existingAdditionalPath2" value="@p2"/>
                </form>

            </div>
        </div>
    </div>
</div>

<partial name="_LocationMapModal" />

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
}

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/js/locationPicker.js"></script>
    <script>
        LocationPicker.init({
            mapId: "locationMap",
            inputSelector: "#Location",
            locateBtnId: "detectLocationBtn",
            latInputId: "Latitude",
            lngInputId: "Longitude",
            statusElId: "locationStatus",
            modalId: "locationMapModal",
            modalMapId: "locationMapBig",
            useLocationBtnId: "useLocationBtn",
            initial: @(Model.Latitude.HasValue && Model.Longitude.HasValue
                ? $"{{ lat: {Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}, lng: {Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)} }}"
                : "null")
        });
    </script>
    <script src="~/js/imageManipulation.js"></script>
    <partial name="_ValidationScriptsPartial" />
}
