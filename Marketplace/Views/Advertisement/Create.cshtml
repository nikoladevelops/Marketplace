@model Marketplace.ViewModels.CreateAdvertisementViewModel

@* Create ad page - form for posting a new listing *@
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">
                
                <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                    <h3 class="fw-bold text-primary mb-0">✨ Create New Advertisement</h3>
                </div>

                <form method="post" asp-action="Create" asp-controller="Advertisement" enctype='multipart/form-data'>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <span class="text-danger d-block mb-2" asp-validation-for="Image"></span>

                    @* Image gallery - upload slots for product photos *@
                    <label class="form-label fw-semibold text-secondary mb-2">Product Images (Click box to upload, click image to zoom)</label>

                    <div class="row g-3 mb-4">
                        @* Main image - required *@
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border-2 border-primary rounded-3 overflow-hidden shadow-sm">
                                <div class="card-body p-0 position-relative bg-light text-center d-flex align-items-center justify-content-center img-slot">
                                    <img id="image1" src="/plusSign.png" data-existing-path="" class="w-100 h-100 object-fit-cover cursor-pointer" onclick="handleImageClick(1, 'imageInput1')" title="Click to upload">
                                    <input asp-for="Image" id="imageInput1" class="d-none" type="file" onchange="handleFileSelected(this, 1)" accept="image/jpeg, image/png"/>
                                </div>
                                <div class="card-footer bg-white border-0 p-2 text-center">
                                    <button id="button1" type="button" onclick="deleteImage(1)" class="btn btn-sm btn-outline-danger w-100" disabled>Remove</button>
                                </div>
                            </div>
                            <small class="text-muted d-block text-center mt-1">Main Image *</small>
                        </div>

                        @* Extra image 1 *@
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border rounded-3 overflow-hidden shadow-sm">
                                <div class="card-body p-0 position-relative bg-light text-center d-flex align-items-center justify-content-center img-slot">
                                    <img id="image2" src="/plusSign.png" data-existing-path="" class="w-100 h-100 object-fit-cover cursor-pointer" onclick="handleImageClick(2, 'imageInput2')" title="Click to upload">
                                    <input asp-for="AdditionalImage1" id="imageInput2" class="d-none" type="file" onchange="handleFileSelected(this, 2)" accept="image/jpeg, image/png"/>
                                </div>
                                <div class="card-footer bg-white border-0 p-2 text-center">
                                    <button id="button2" type="button" onclick="deleteImage(2)" class="btn btn-sm btn-outline-danger w-100" disabled>Remove</button>
                                </div>
                            </div>
                            <small class="text-muted d-block text-center mt-1">Extra 1</small>
                        </div>

                        @* Extra image 2 *@
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border rounded-3 overflow-hidden shadow-sm">
                                <div class="card-body p-0 position-relative bg-light text-center d-flex align-items-center justify-content-center img-slot">
                                    <img id="image3" src="/plusSign.png" data-existing-path="" class="w-100 h-100 object-fit-cover cursor-pointer" onclick="handleImageClick(3, 'imageInput3')" title="Click to upload">
                                    <input asp-for="AdditionalImage2" id="imageInput3" class="d-none" type="file" onchange="handleFileSelected(this, 3)" accept="image/jpeg, image/png"/>
                                </div>
                                <div class="card-footer bg-white border-0 p-2 text-center">
                                    <button id="button3" type="button" onclick="deleteImage(3)" class="btn btn-sm btn-outline-danger w-100" disabled>Remove</button>
                                </div>
                            </div>
                            <small class="text-muted d-block text-center mt-1">Extra 2</small>
                        </div>

                        @* Extra image 3 *@
                        <div class="col-6 col-md-3">
                            <div class="card h-100 border rounded-3 overflow-hidden shadow-sm">
                                <div class="card-body p-0 position-relative bg-light text-center d-flex align-items-center justify-content-center img-slot">
                                    <img id="image4" src="/plusSign.png" data-existing-path="" class="w-100 h-100 object-fit-cover cursor-pointer" onclick="handleImageClick(4, 'imageInput4')" title="Click to upload">
                                    <input asp-for="AdditionalImage3" id="imageInput4" class="d-none" type="file" onchange="handleFileSelected(this, 4)" accept="image/jpeg, image/png"/>
                                </div>
                                <div class="card-footer bg-white border-0 p-2 text-center">
                                    <button id="button4" type="button" onclick="deleteImage(4)" class="btn btn-sm btn-outline-danger w-100" disabled>Remove</button>
                                </div>
                            </div>
                            <small class="text-muted d-block text-center mt-1">Extra 3</small>
                        </div>
                    </div>

                    @* AI auto-fill banner - generate title and description from image *@
                    <div class="p-3 mb-4 bg-light rounded-3 border border-primary-subtle text-center">
                        <button type="button" id="aiGenerateBtn" onclick="triggerSmartListingAI()" class="btn btn-primary fw-semibold px-4 shadow-sm" disabled>
                            ✨ Auto-Fill Listing Details with AI
                        </button>
                        <small class="text-muted d-block mt-1">Upload a main image first, then click to let AI generate your title and description.</small>
                    </div>

                    @* Text inputs - title and description *@
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input class="form-control form-control-lg rounded-3" asp-for="Title" placeholder="e.g. Vintage Acoustic Guitar"/>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea class="form-control rounded-3" asp-for="Description" rows="6" placeholder="Provide a detailed description of your item..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    @* Price and location fields *@
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">€</span>
                                <input class="form-control rounded-end-3" asp-for="Price" placeholder="0.00" type="number" step="0.01" min="1" />
                            </div>
                            <small class="text-muted">Price in EUR</small>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Location" class="form-label fw-semibold"></label>
                            <div class="d-flex gap-2">
                                <input class="form-control rounded-3" asp-for="Location" placeholder="e.g. Plovdiv, Bulgaria"/>
                                <button type="button" id="detectLocationBtn" class="btn btn-outline-primary rounded-3 flex-shrink-0" title="Detect my location">📍 Detect</button>
                            </div>
                            <span asp-validation-for="Location" class="text-danger small"></span>
                            <small id="locationStatus" class="d-block text-muted small mt-1"></small>
                        </div>
                    </div>

                    @* Map picker for exact meeting location *@
                    <div class="mb-4">
                        <div id="locationMap" class="location-map-inline rounded-3 border"></div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <small class="text-muted">Click the map or drag the pin to set the exact meeting point.</small>
                            <button type="button" class="btn btn-link btn-sm p-0" data-bs-toggle="modal" data-bs-target="#locationMapModal">⤢ Expand map</button>
                        </div>
                        <input type="hidden" asp-for="Latitude"/>
                        <input type="hidden" asp-for="Longitude"/>
                    </div>

                    @* Category selector *@
                    <div class="mb-4">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Category</label>
                        <select asp-for="CategoryId" asp-items="@Model.CategoryDropDown" class="form-select rounded-3">
                            <option value="-1">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    @* Submit and cancel buttons *@
                    <div class="d-flex gap-2 pt-3 border-top">
                        <button type="submit" class="btn btn-success px-4 fw-semibold rounded-3 shadow-sm">Create Advertisement</button>
                        <a class="btn btn-light px-4 rounded-3 border" href="/Users/@User.Identity?.Name">Cancel</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<partial name="_LocationMapModal" />

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
}

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/js/locationPicker.js"></script>
    <script>
        LocationPicker.init({
            mapId: "locationMap",
            inputSelector: "#Location",
            locateBtnId: "detectLocationBtn",
            latInputId: "Latitude",
            lngInputId: "Longitude",
            statusElId: "locationStatus",
            modalId: "locationMapModal",
            modalMapId: "locationMapBig",
            useLocationBtnId: "useLocationBtn",
            initial: null
        });
    </script>
    <script src="~/js/imageManipulation.js"></script>
}
