@using Marketplace.Utility
@using Marketplace.ViewModels
@model IEnumerable<Marketplace.ViewModels.SimplifiedAdvertisementViewModel>
@{
    var profilePictureSrc = "/noProfilePicture.png";
    var description = "This user has no description.";

    if (ViewBag.ProfilePicturePath != null)
    {
        profilePictureSrc = ViewBag.ProfilePicturePath;
    }

    if (ViewBag.Description != null)
    {
        description = ViewBag.Description;
    }

    int pageNumber = ViewBag.PageNumber ?? 0;
    int maxCountPages = ViewBag.MaxCountPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? Model.Count();
    string username = ViewBag.Username as string ?? "";
}

<div class="container">
    <div class="row g-4">
        <div class="col-md-4 col-lg-3 text-center">
            <h3 class="h5 fw-bold mb-3">Profile Picture</h3>
            <div class="profile-avatar-wrap mx-auto">
                <img id="image1" src="@profilePictureSrc" class="w-100 h-100 object-fit-cover" alt="Profile Picture">
            </div>
        </div>
        <div class="col-md-8">
            <div class="card h-100 p-0 border-0 shadow-sm rounded-4">
                <h3 class="h5 fw-bold mb-2 px-3 pt-3">Contact Info</h3>
                <div class="border rounded-4 text-center p-3 mx-3 mb-3 bg-light">
                    @if (@ViewBag.PhoneNumber != null)
                    {
                        <label class="small text-muted">Phone number</label>
                        <input readonly value="@ViewBag.PhoneNumber" class="form-control text-center mb-3"/>
                    }
                    <label class="small text-muted">Email</label>
                    <input readonly value="@ViewBag.Email" class="form-control text-center"/>
                </div>
            </div>
        </div>
    </div>
</div>
<h3 class="mt-4">Description</h3>
        @if (ViewBag.Description == null)
        {
            <textarea readonly name="description" placeholder="@description" class="form-control mb-3 rounded-3" rows="3"></textarea>
        }
        else
        {
            <textarea readonly name="description" class="form-control mb-3 rounded-3" rows="3">@description</textarea>
        }

@if (totalCount == 0)
{
    <h3>This user has no advertisements.</h3>
}
else
{
    <h3>User Advertisements <small class="text-muted fs-6 fw-normal">(@totalCount)</small></h3>

    <div class="ad-grid">
        <div class="row g-3">
            @foreach (var currentAd in Model)
            {
                <div class="col-6 col-md-4 col-lg-3 d-flex flex-column">
                    <div class="card ad-card border-0 rounded-4 overflow-hidden shadow-sm flex-fill w-100 position-relative d-flex flex-column">
                        <div class="ad-card-img-wrap flex-shrink-0">
                            <img src="@currentAd.ImagePath" loading="lazy" alt="Ad Image">
                            <span class="badge bg-success ad-badge position-absolute top-0 end-0 m-2">@currentAd.Category</span>
                        </div>

                        <div class="card-body pb-2 d-flex flex-column flex-grow-1 position-relative">
                            <h6 class="card-title fw-semibold text-truncate mb-1" title="@currentAd.Title">@currentAd.Title</h6>
                            <p class="ad-price h5 mb-1">@PriceFormatter.ToEur(currentAd.Price)</p>
                            <p class="text-muted small mb-0">📍 @currentAd.Location</p>
                            <a asp-action="Show" asp-controller="Advertisement" asp-route-id="@currentAd.Id" class="stretched-link" aria-label="View @currentAd.Title"></a>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0 px-3 pb-3 mt-auto d-flex gap-2 position-relative" style="z-index:1;">
                            <a asp-action="Show" asp-controller="Advertisement" asp-route-id="@currentAd.Id" class="btn btn-sm btn-primary flex-fill">View</a>
                            @if (User.IsInRole(Helper.AdminRole))
                            {
                                <a class="btn btn-sm btn-outline-danger flex-fill" onclick="event.stopPropagation(); showDeleteAdModal('@currentAd.Title',@currentAd.Id)">Delete</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @if (maxCountPages > 1)
    {
        <div class="text-center pagination-links mt-4">
            <a href="/Users/@username?pageNumber=@(pageNumber - 1)" class="page-nav @(pageNumber <= 0 ? "disabled pe-none opacity-50" : "")" title="Previous page">&#60;</a>
            @{
                int maximumDisplayedPages = 10;
                int startingIndex = pageNumber - (pageNumber % maximumDisplayedPages);
                int endingIndex = (pageNumber + maximumDisplayedPages) - (pageNumber % maximumDisplayedPages);
                if (endingIndex > maxCountPages) endingIndex = maxCountPages;
                @for (var i = startingIndex; i < endingIndex; i++)
                {
                    @if (i == pageNumber)
                    {
                        <a class="active" href="/Users/@username?pageNumber=@i">@i</a>
                        continue;
                    }
                    <a href="/Users/@username?pageNumber=@i">@i</a>
                }
                if (!(endingIndex >= maxCountPages))
                {
                    var lastPageIndex = maxCountPages - 1;
                    <span class="px-1 text-muted">...</span>
                    <a href="/Users/@username?pageNumber=@lastPageIndex">@lastPageIndex</a>
                }
            }
            <a href="/Users/@username?pageNumber=@(pageNumber + 1)" class="page-nav @(pageNumber >= maxCountPages - 1 ? "disabled pe-none opacity-50" : "")" title="Next page">&#62;</a>
        </div>
    }

    @if (User.IsInRole(Helper.AdminRole))
    {
        <!-- Modal -->
        <form method="post" name="deleteAdForm" asp-action="Delete" asp-controller="Advertisement">
        <div class="modal fade" id="deleteAdModal" tabindex="-1">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title">Delete Advertisement - <span class="adToDeleteTitle"></span></h5>
              </div>
              <div class="modal-body">
                <p>You are about to delete - "<span class="adToDeleteTitle"></span>". Are you sure about that?</p>
              </div>
              <div class="modal-footer">
                <a onclick="hideDeleteAdModal()" class="btn btn-secondary">Cancel</a>
                <button type="submit" id="deleteAdButton" class="btn btn-danger">Delete</button>
              </div>
            </div>
          </div>
        </div>
        </form>
    }
}

@section Scripts
{
    @if (User.IsInRole(Helper.AdminRole))
    {
       <script defer src="~/js/deleteAdvertisement.js"></script>
    }
}
