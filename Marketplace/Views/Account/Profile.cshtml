@using Marketplace.Utility
@using Marketplace.ViewModels
@model IEnumerable<Marketplace.ViewModels.SimplifiedAdvertisementViewModel>
@{
    var countAds = @Model.Count();
    var profilePictureSrc = "/noProfilePicture.png";
    var description = "This user has no description.";

    if (ViewBag.ProfilePicturePath != null)
    {
        profilePictureSrc = ViewBag.ProfilePicturePath;
    }

    if (ViewBag.Description != null)
    {
        description = ViewBag.Description;
    }
}

<div class="container">
    <div class="row g-4">
        <div class="col-md-4 col-lg-3 text-center">
            <h3 class="h5 fw-bold mb-3">Profile Picture</h3>
            <div class="profile-avatar-wrap mx-auto">
                <img id="image1" src="@profilePictureSrc" class="w-100 h-100 object-fit-cover" alt="Profile Picture">
            </div>
        </div>
    @if (@ViewBag.PhoneNumber != null)
    {
        <div class="card col-8 p-0 mb-3 mx-1 border-0">
        <h3>Contact Info</h3>
            <div class="border border-primary rounded text-center p-3">
                <label>Phone number</label>
                <input readonly value="@ViewBag.PhoneNumber" class="form-control text-center mb-3"/>
                <label>Email</label>
                <input readonly value="@ViewBag.Email" class="form-control text-center"/>
            </div>
        </div>
    }
    else
    {
        <div class="card col-8 p-0 mb-3 mx-1 border-0">
        <h3>Contact Info</h3>
            <div class="border border-primary rounded text-center p-3">
                <label>Email</label>
                <input readonly value="@ViewBag.Email" class="form-control text-center"/>
            </div>
        </div> 
    }
    </div>
</div>
<h3>Description</h3>
        @if (ViewBag.Description == null)
        {
            <textarea readonly name="description" placeholder="@description" class="form-control mb-3"></textarea>
        }
        else
        {
            <textarea readonly name="description" class="form-control mb-3">@description</textarea>
        }

@if (countAds == 0)
{
    <h3>This user has no advertisements.</h3>
}
else
{
    <h3>User Advertisements</h3>

    <div class="container">
        @for (var i = 0; i < countAds; i += 4)
        {
            <div class="row g-3">
            @for (var j = 0; j < 4; j++)
            {
                @if (i + j == countAds)
                {
                    break;
                }

                var currentAd = Model.ElementAt(i + j);
                <div class="col-6 col-md-4 col-lg-3">
                    <a asp-action="Show" asp-controller="Advertisement" asp-route-id="@currentAd.Id" class="text-decoration-none h-100 d-block">
                        <div class="card ad-card border-0 rounded-4 overflow-hidden shadow-sm h-100 position-relative">
                            <div class="ad-card-img-wrap">
                                <img src="@currentAd.ImagePath" loading="lazy" alt="Ad Image">
                                <span class="badge bg-success ad-badge position-absolute top-0 end-0 m-2">@currentAd.Category</span>
                            </div>

                        <div class="card-body pb-2">
                            <h6 class="card-title fw-semibold text-truncate mb-1" title="@currentAd.Title">@currentAd.Title</h6>
                            <p class="ad-price h5 mb-1">@currentAd.Price EUR</p>
                            <p class="text-muted small mb-0">📍 @currentAd.Location</p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0 px-3 pb-3 mt-auto d-flex gap-2">
                            <span class="btn btn-sm btn-primary flex-fill">View</span>
                            @if (User.IsInRole(Helper.AdminRole))
                            {
                                <a class="btn btn-sm btn-outline-danger flex-fill position-relative" style="z-index:1;" onclick="event.stopPropagation(); showDeleteAdModal('@currentAd.Title',@currentAd.Id)">Delete</a>
                            }
                        </div>
                    </div>
                    </a>
                </div>
            }
            </div>
        }
    </div>

    @if (User.IsInRole(Helper.AdminRole))
    {
        <!-- Modal -->
        <form method="post" name="deleteAdForm" asp-action="Delete" asp-controller="Advertisement">
        <div class="modal fade" id="deleteAdModal" tabindex="-1">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title">Delete Advertisement - <span class="adToDeleteTitle"></span></h5>
              </div>
              <div class="modal-body">
                <p>You are about to delete - "<span class="adToDeleteTitle"></span>". Are you sure about that?</p>
              </div>
              <div class="modal-footer">
                <a onclick="hideDeleteAdModal()" class="btn btn-secondary">Cancel</a>
                <button type="submit" id="deleteAdButton" class="btn btn-danger">Delete</button>
              </div>
            </div>
          </div>
        </div>
        </form>
    }
}

@section Scripts
{
    @if (User.IsInRole(Helper.AdminRole))
    {
       <script defer src="~/js/deleteAdvertisement.js"></script>
    }
}