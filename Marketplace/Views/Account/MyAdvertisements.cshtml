@using Marketplace.ViewModels
@model IEnumerable<Marketplace.ViewModels.SimplifiedAdvertisementViewModel>
@{
    var countAds = @Model.Count();
}

@if (countAds == 0)
{
    <div class="text-center py-5">
        <h3 class="mb-2">You have no advertisements</h3>
        <p class="text-muted mb-4">Create your first listing and it will show up here.</p>
        <a asp-action="Create" asp-controller="Advertisement" class="btn btn-primary px-4">+ Create An Advertisement</a>
    </div>
}
else
{
    <div class="page-header">
        <h3>My Advertisements</h3>
        <a asp-action="Create" asp-controller="Advertisement" class="btn btn-primary ms-auto">+ Create New</a>
    </div>
    
    <div class="container">
        @for (var i = 0; i < countAds; i += 4)
        {
            <div class="row g-3">
            @for (var j = 0; j < 4; j++)
            {
                @if (i + j == countAds)
                {
                    break;
                }

                var currentAd = Model.ElementAt(i + j);
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card ad-card border-0 rounded-4 overflow-hidden shadow-sm h-100 position-relative">
                        <img src="@currentAd.ImagePath" data-lightbox="my-ads" loading="lazy" alt="Advertisement Image">
                        <span class="badge bg-success ad-badge position-absolute top-0 end-0 m-2">@currentAd.Category</span>

                        <div class="card-body pb-2">
                            <h6 class="card-title fw-semibold text-truncate mb-1" title="@currentAd.Title">@currentAd.Title</h6>
                            <p class="ad-price h5 mb-1">@currentAd.Price EUR</p>
                            <p class="text-muted small mb-0">📍 @currentAd.Location</p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0 px-3 pb-3 mt-auto d-flex gap-2">
                            <a class="btn btn-sm btn-primary flex-fill" asp-action="Show" asp-controller="Advertisement" asp-route-id="@currentAd.Id">View</a>
                            <a class="btn btn-sm btn-outline-warning flex-fill" asp-action="Edit" asp-controller="Advertisement" asp-route-id="@currentAd.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger flex-fill" onclick="showDeleteAdModal('@currentAd.Title',@currentAd.Id)">Delete</a>
                        </div>
                    </div>
                </div>
            }
            </div>
        }
    </div>

<!-- Modal -->
<form method="post" name="deleteAdForm" asp-action="Delete" asp-controller="Advertisement">
<div class="modal fade" id="deleteAdModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Delete Advertisement - <span class="adToDeleteTitle"></span></h5>
      </div>
      <div class="modal-body">
        <p>You are about to delete one of your advertisements - "<span class="adToDeleteTitle"></span>". Are you sure about that?</p>
      </div>
      <div class="modal-footer">
        <a onclick="hideDeleteAdModal()" class="btn btn-secondary">Cancel</a>
        <button type="submit" id="deleteAdButton" class="btn btn-danger">Delete</button>
      </div>
    </div>
  </div>
</div>
</form>
}

@section Scripts
{
    <script defer src="~/js/deleteAdvertisement.js"></script>
}