@using Marketplace.Utility
@model Marketplace.ViewModels.MyProfileViewModel

@{
    var profilePictureSrc = !string.IsNullOrEmpty(Model.ExistingProfilePicturePath) ? Model.ExistingProfilePicturePath : "/noProfilePicture.png";
    var description = !string.IsNullOrEmpty(Model.Description) ? Model.Description : "No description. Consider adding one.";
}

@if (User.IsInRole(Helper.AdminRole))
{
    <div class="alert alert-success text-center rounded-4 border-0">You are logged in as Admin</div>
}

@if (User.IsInRole(Helper.PremiumRole))
{
    <div class="alert alert-warning text-center rounded-4 border-0 mb-0 bg-warning bg-opacity-10 text-dark">You have Premium ✨</div>
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white">
                <div class="page-header">
                    <h3>👤 My Profile</h3>
                </div>

                <form method="post" asp-action="Update" asp-controller="Account" enctype='multipart/form-data'>
                    <div class="row g-4">
                        <!-- Profile Picture -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary mb-2">Profile Picture</label>
                            <div class="card h-100 border-2 border-primary rounded-4 overflow-hidden shadow-sm">
                                <div class="card-body p-0 position-relative bg-light d-flex align-items-center justify-content-center img-slot-lg">
                                    <img id="image1" src="@profilePictureSrc"
                                         data-existing-path="@Model.ExistingProfilePicturePath"
                                         class="w-100 h-100 object-fit-cover cursor-pointer"
                                         onclick="handleImageClick(1, 'imageInput1')" title="Click to view or change">
                                    <input asp-for="ProfilePicture" id="imageInput1" class="d-none" type="file" onchange="handleFileSelected(this, 1)" accept="image/jpeg, image/png"/>
                                </div>
                                <div class="card-footer bg-white border-0 p-2 text-center">
                                    <button id="changeProfileImage" type="button" onclick="triggerInputBrowse('imageInput1')" class="btn btn-sm btn-outline-primary w-100 mb-1">Change</button>
                                    <button id="button1" type="button" onclick="deleteImage(1, 'existingPathInput')" class="btn btn-sm btn-outline-danger w-100" disabled>Remove</button>
                                </div>
                            </div>
                        </div>

                        <!-- Contact Info -->
                        <div class="col-md-8">
                            <label class="form-label fw-semibold text-secondary mb-2">Contact Info</label>
                            <div class="border rounded-4 p-3 bg-light h-100">
                                <label asp-for="PhoneNumber" class="form-label small fw-semibold">Phone number</label>
                                <input asp-for="PhoneNumber" class="form-control mb-2" placeholder="Number"/>
                                <div class="form-check">
                                    <input asp-for="PhoneNumberAgreement" type="checkbox" class="form-check-input"/>
                                    <label asp-for="PhoneNumberAgreement" class="form-check-label small">I agree that everybody can view this information on my profile page and on my advertisements</label>
                                </div>
                                <span class="d-block small field-validation-error">@ViewBag.AgreementError</span>
                                <span class="d-block small field-validation-error">@ViewBag.PhoneError</span>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mt-4">
                        <label class="form-label fw-semibold text-secondary">Description</label>
                        @if (Model.Description == null)
                        {
                            <textarea name="description" placeholder="@description" class="form-control rounded-3" rows="4"></textarea>
                        }
                        else
                        {
                            <textarea name="description" class="form-control rounded-3" rows="4">@description</textarea>
                        }
                        <div class="text-center mb-3 mt-1">
                            <span asp-validation-for="Description" class="field-validation-error"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 pt-3 border-top">
                        <button type="submit" class="btn btn-success px-4 fw-semibold rounded-3 shadow-sm">Update Profile</button>
                    </div>

                    <input type="hidden" asp-for="ExistingProfilePicturePath" id="existingPathInput"/>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/js/imageManipulation.js"></script>
}
